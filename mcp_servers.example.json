{
  "servers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "./"],
      "agents": ["security", "bug_detection", "fix"]
    },
    "git": {
      "command": "uvx",
      "args": ["mcp-server-git", "--repository", "./"],
      "agents": ["security", "bug_detection"]
    },
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"],
      "agents": ["security"]
    }
  }
}
